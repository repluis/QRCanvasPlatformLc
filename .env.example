# Database
DATABASE_URL="postgresql://postgres:secret@localhost:5432/QRCanvasPlatform?schema=public"
# On Vercel the Supabase integration sets POSTGRES_PRISMA_URL (pooler URL);
# when present it takes precedence over DATABASE_URL
# POSTGRES_PRISMA_URL=

# JWT (required in production; the server refuses to start without it)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Public origin encoded in template QR codes, e.g. https://your-app.vercel.app
# Optional: defaults to the request's Origin header
APP_URL=
