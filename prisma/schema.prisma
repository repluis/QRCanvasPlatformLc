generator client {
  provider = "prisma-client-js"
}

// Used by the Prisma CLI (migrations). At runtime server/lib/prisma.ts picks
// the URL, and scripts/migrate-deploy.mjs picks it for deploys.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  name          String
  email         String    @unique
  password      String
  emailVerified DateTime? @map("email_verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  pages         Page[]

  @@map("users")
}

model Page {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  title     String
  slug      String   @unique
  elements  Json     @default("[]")
  canvases  Json?
  background String  @default("#ffffff")
  status    Boolean  @default(true)
  userId    Int      @map("user_id")
  // Nullable: pages written by older versions of the app may lack timestamps
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pages")
}
