{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist/server",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "isolatedModules": false,
    "allowImportingTsExtensions": false,
    "composite": false,
    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["./api/*"]
    }
  },
  "include": ["api/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}